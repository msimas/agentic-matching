# Copy to .env and adjust. All variables are optional; sane CPU defaults are baked into
# src/agentic_matching/config.py.

# --- LLM backend (vLLM OpenAI-compatible server) ---
# cpu (default, this dev box) | cuda (NVIDIA) | rocm (AMD) | mock (offline dev/test
# stand-in with no LLM server required -- see src/agentic_matching/llm/mock.py)
LLM_DEVICE=cpu
LLM_MODEL=NousResearch/Meta-Llama-3.1-8B-Instruct
LLM_DTYPE=bfloat16
# Leave unset to have server.py launch/manage a local `vllm serve` subprocess.
# Set to point at an already-running (e.g. remote GPU) OpenAI-compatible endpoint instead.
# LLM_BASE_URL=http://some-gpu-host:8001/v1
LLM_HOST=127.0.0.1
LLM_PORT=8001
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEMORY_UTILIZATION=0.85
LLM_TENSOR_PARALLEL_SIZE=1
LLM_STARTUP_TIMEOUT_S=900

# --- Bounded agentic loop ---
AGENT_MAX_ROUNDS=3
AGENT_STABILIZATION_DELTA=0.01
