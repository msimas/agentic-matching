# Copy to .env and adjust. All variables are optional; sane defaults are baked into
# src/agentic_matching/config.py.

# --- LLM backend (served as an OpenAI-compatible endpoint) ---
# ollama (real LLM, via a local or remote Ollama server) | databricks (Databricks Model
# Serving, pay-per-token) | mock (offline dev/test stand-in, no server required -- see
# src/agentic_matching/llm/mock.py)
LLM_DEVICE=ollama

# --- Ollama (LLM_DEVICE=ollama) ---
# Install: https://ollama.com/download (a single installer, no manual build step).
# server.py will `ollama pull` this model automatically if it isn't already present.
# LLM_MODEL=qwen2.5:1.5b
# LLM_PORT=11434
LLM_HOST=127.0.0.1
# Leave unset to have server.py launch/manage a local `ollama serve` subprocess (or
# reuse one already running). Set to point at an already-running server instead (e.g.
# a remote host, or a separately-managed Ollama instance).
# LLM_BASE_URL=http://some-host:11434/v1
LLM_STARTUP_TIMEOUT_S=900
# LLM_REQUEST_TIMEOUT_S=600  # bump this for a slower/larger local model (e.g. 1200 for
# an 8B+ model on modest hardware) -- a single revision call can take several minutes.

# --- Databricks Model Serving (LLM_DEVICE=databricks) ---
# Read from the same DATABRICKS_HOST/DATABRICKS_TOKEN names the Databricks CLI/SDK
# themselves use, not duplicated under an LLM_-prefixed name. No server to
# start/manage -- it's already running as a cloud service; scripts talk to it directly.
# DATABRICKS_HOST=https://<your-workspace>.databricks.com
# DATABRICKS_TOKEN=<a personal access token, or better: a scoped secret, never commit this>
# Either a bare serving-endpoint name (databricks-meta-llama-3-3-70b-instruct) or the
# full invocations URL copy-pasted from the Databricks UI's "Query endpoint" page --
# either works, the endpoint name is extracted from the URL automatically.
# DATABRICKS_LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# This is a PAID, pay-per-token endpoint -- every LLM call in every agent loop (many
# per block run) costs real money while LLM_DEVICE=databricks is set. Switch back to
# LLM_DEVICE=ollama when you're not deliberately using it.

# temperature: used for revision rounds (an existing rule/attribute set + real
# evaluation data to stay faithful to) and as the fallback for loops that never
# "propose from scratch" (linking's revision-only loop always uses this one).
# exploration_temperature: used only for a genuine round-0 "propose from scratch" call
# (blocking/attributes, only when there's no seed to build on) -- higher on purpose,
# since more sampling diversity is pure upside when nothing exists yet to be faithful to.
# LLM_TEMPERATURE=0.15
# LLM_EXPLORATION_TEMPERATURE=0.6

# --- Bounded agentic loop ---
AGENT_MAX_ROUNDS=3
AGENT_STABILIZATION_DELTA=0.01
AGENT_MAX_OUTER_ROUNDS=2

# --- Logging ---
# INFO (default) shows round-by-round progress. DEBUG additionally shows every LLM
# call's full query (system + user prompt) and raw response -- verbose (full prompts,
# every round) but invaluable when diagnosing a bad or surprising proposal.
# LOG_LEVEL=DEBUG
