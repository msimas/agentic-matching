# Copy to .env and adjust. All variables are optional; sane per-device defaults are
# baked into src/agentic_matching/config.py (including LLM_PORT/LLM_MODEL, which
# default differently for LLM_DEVICE=ollama vs. everything else -- see below). Leave a
# variable out entirely (don't just set it to what looks like "the default") if you
# want that per-device default to actually apply when switching LLM_DEVICE.

# --- LLM backend (served as an OpenAI-compatible endpoint -- vLLM or Ollama) ---
# cpu (vLLM CPU build) | cuda (NVIDIA, vLLM) | rocm (AMD, vLLM) | ollama (any device,
# via Ollama) | mock (offline dev/test stand-in, no server required -- see
# src/agentic_matching/llm/mock.py)
LLM_DEVICE=cpu

# --- vLLM (LLM_DEVICE=cpu|cuda|rocm) ---
# vLLM's CPU build is not a regular PyPI wheel and must be built/installed separately
# (see README) -- if that's giving you trouble, LLM_DEVICE=ollama below is usually the
# easier path to a working CPU backend.
# LLM_MODEL=NousResearch/Meta-Llama-3.1-8B-Instruct
# LLM_DTYPE=bfloat16
# LLM_PORT=8001
# LLM_GPU_MEMORY_UTILIZATION=0.85
# LLM_TENSOR_PARALLEL_SIZE=1

# --- Ollama (LLM_DEVICE=ollama) ---
# Install: https://ollama.com/download (a single installer, no manual CPU build step).
# server.py will `ollama pull` this model automatically if it isn't already present.
# LLM_MODEL=qwen2.5:1.5b
# LLM_PORT=11434

# --- Common to all backends ---
LLM_HOST=127.0.0.1
# Leave unset to have server.py launch/manage a local server subprocess. Set to point
# at an already-running (e.g. remote GPU, or a separately-managed Ollama/vLLM) instead.
# LLM_BASE_URL=http://some-gpu-host:8001/v1
LLM_MAX_MODEL_LEN=4096
LLM_STARTUP_TIMEOUT_S=900

# --- Bounded agentic loop ---
AGENT_MAX_ROUNDS=3
AGENT_STABILIZATION_DELTA=0.01
